# Copy to .env and fill in. .env is gitignored; never commit a real token or key.
# Instance-wide
DISCORD_TOKEN=
# Guild (server) ID: the /bug and /feature commands are synced to this guild only.
DISCORD_GUILD_ID=<intake-guild-server-id>
# GitHub App (instance-wide)
# App ID: the App's settings page, "App ID". 0 is rejected.
GITHUB_APP_ID=0
# Installation ID: org Settings, GitHub Apps, Configure; the number at the end of the URL.
GITHUB_APP_INSTALLATION_ID=0
# A path, not the key: mount the downloaded .pem read-only at this path.
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-key.pem
# Target: intake channel -> output repo
# Channel ID: Discord Developer Mode, right-click #c4i-github-issues, Copy Channel ID. 0 is rejected.
DISCORD_CHANNEL_ID=0
DISCORD_CHANNEL_NAME=c4i-github-issues
DISCORD_CATEGORY=C4I
GITHUB_REPO=4IRL/chores4irl
GITHUB_REPO_ID=<output-repo-id>
GITHUB_LABEL_BUG=bug
GITHUB_LABEL_FEATURE=enhancement
